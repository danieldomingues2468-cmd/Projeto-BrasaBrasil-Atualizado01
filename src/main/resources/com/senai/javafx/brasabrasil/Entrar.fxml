<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import com.senai.javafx.brasabrasil.Escala?>
<?import javafx.scene.layout.*?>

<!--
    TELA DE LOGIN
    Mesma estrutura do Cadastro, para as duas telas parecerem uma só família.
-->
<Escala xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.senai.javafx.brasabrasil.EntrarController"
        stylesheets="@style.css"
        styleClass="pagina">

<BorderPane styleClass="pagina">

    <top>
        <fx:include source="Cabecalho.fxml"/>
    </top>

    <center>
        <StackPane styleClass="fundo-marca">
            <ScrollPane styleClass="pagina-scroll"
                        fitToWidth="true"
                        fitToHeight="true"
                        hbarPolicy="NEVER">
                <content>
                    <StackPane>

                        <HBox alignment="CENTER"
                              spacing="80.0"
                              maxWidth="1200.0"
                              maxHeight="-Infinity">

                            <padding>
                                <Insets top="16.0" right="60.0" bottom="16.0" left="60.0"/>
                            </padding>

                            <!-- BLOCO DA MARCA -->
                            <VBox alignment="CENTER_LEFT"
                                  spacing="12.0"
                                  HBox.hgrow="ALWAYS"
                                  minWidth="-Infinity"
                                  prefWidth="460.0">

                                <Label text="BRASA BRASIL" styleClass="eyebrow"/>

                                <VBox spacing="0.0">
                                    <Label text="BOM TER VOCÊ"
                                           styleClass="titulo-grande"
                                           minWidth="-Infinity"/>
                                    <Label text="DE VOLTA."
                                           styleClass="titulo-destaque"
                                           minWidth="-Infinity"/>
                                </VBox>

                                <Region styleClass="divisor-amarelo"
                                        minHeight="3.0"
                                        prefHeight="3.0"
                                        maxHeight="3.0"
                                        prefWidth="90.0"
                                        maxWidth="90.0"/>

                                <Label text="Entre na sua conta e continue aproveitando."
                                       styleClass="texto-corpo"
                                       wrapText="true"
                                       maxWidth="440.0"/>
                            </VBox>

                            <!-- CARTÃO DO FORMULÁRIO -->
                            <VBox styleClass="cartao-form"
                                  alignment="CENTER"
                                  spacing="14.0"
                                  minWidth="460.0"
                                  prefWidth="480.0"
                                  maxWidth="480.0"
                                  maxHeight="-Infinity">

                                <Label text="ENTRAR NA CONTA" styleClass="cartao-titulo"/>
                                <Label text="Informe seu nome e sua senha" styleClass="texto-secundario"/>

                                <Region minHeight="6.0" prefHeight="6.0"/>

                                <!-- NOME -->
                                <VBox spacing="5.0">
                                    <Label text="NOME" styleClass="campo-rotulo"/>
                                    <TextField fx:id="campoNome"
                                               styleClass="campo"
                                               promptText="Digite seu nome cadastrado"
                                               prefHeight="46.0"
                                               maxWidth="Infinity"/>
                                </VBox>

                                <!-- SENHA -->
                                <VBox spacing="5.0">
                                    <Label text="SENHA" styleClass="campo-rotulo"/>
                                    <PasswordField fx:id="campoSenha"
                                                   styleClass="campo"
                                                   promptText="Digite sua senha"
                                                   prefHeight="46.0"
                                                   maxWidth="Infinity"/>
                                </VBox>

                                <!-- MENSAGEM DE RETORNO -->
                                <Label fx:id="mensagem"
                                       styleClass="mensagem-form"
                                       text=""
                                       wrapText="true"
                                       minHeight="20.0"
                                       maxWidth="Infinity"/>

                                <Button text="ENTRAR   →"
                                        onAction="#entrar"
                                        styleClass="botao-primario"
                                        prefHeight="48.0"
                                        maxWidth="Infinity"/>

                                <HBox alignment="CENTER" spacing="6.0">
                                    <Label text="Ainda não tem uma conta?" styleClass="texto-secundario"/>
                                    <Button text="CADASTRE-SE" onAction="#abrirCadastro" styleClass="botao-link"/>
                                </HBox>
                            </VBox>

                        </HBox>

                    </StackPane>
                </content>
            </ScrollPane>
        </StackPane>
    </center>

</BorderPane>

</Escala>
